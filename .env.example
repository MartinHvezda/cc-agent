# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Vector Database Configuration (for issue investigation)
VECTOR_DB_URL=your_vector_db_url_here
VECTOR_DB_API_KEY=your_vector_db_api_key_here

# Customer Support Tools Configuration
JIRA_API_URL=your_jira_url_here
JIRA_API_TOKEN=your_jira_token_here
JIRA_PROJECT_KEY=CS

# IAM System Configuration
IAM_API_URL=your_iam_api_url_here
IAM_API_TOKEN=your_iam_token_here

# Logging and Debug
DEBUG=true
LOG_LEVEL=INFO